# =========================
# Docker / NGINX
# =========================
TKNT_WEB_PORT=8080
TKNT_STATIC_ASSETS_ROOT=./frontend/public/assets

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=tknt
POSTGRES_USER=tknt
POSTGRES_PASSWORD=tknt_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Admin connection, used by data-loading scripts when needed.
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
PG_ADMIN_DB=
PG_ADMIN_HOST=
PG_ADMIN_PORT=

# =========================
# Search / embeddings
# =========================
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=hackathon-hybrid
EMBED_MODEL=text-embedding-3-small
VECTOR_DIMS=1536
BATCH_SIZE=64
AUTO_EMBED_ON_LOAD=0

# =========================
# OpenAI / model access
# =========================
OPENAI_API_KEY=
OPENAI_API_VERSION=2024-08-01-preview
OPENAI_PRIMARY_MODEL=gpt-5.4-mini
OPENAI_HELPER_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_API_KEY=
OPENROUTER_API_KEY=

# =========================
# App / auth
# =========================
TKNT_API_KEY=change-me
TKNT_LOG_LEVEL=INFO
TKNT_SHARED_INVENTORY_TENANT_ID=demo_tenant
TKNT_ENABLE_DEMO_INVENTORY=1
TKNT_DEMO_INVENTORY_ENABLED=1
TKNT_AUTO_LOAD_DEMO_DATA=1
TKNT_AUTH_SESSION_TTL_DAYS=30
TKNT_AUTH_PBKDF2_ITERATIONS=240000

# =========================
# Pipeline behavior
# =========================
SOFT_RULE_SIM_THRESHOLD=0.72
SOFT_RULE_LLM_CHECK=0
CRAWL4AI_ENABLED=0
USE_VERIFIER_FLOW=0
SELF_IMPROVEMENT_MAX_ATTEMPTS=0
TKNT_ABLATION_MODE=full
TKNT_PROMPT_COMPILER_INCLUDE_MINOR_DECOR=0
TKNT_REQUEST_CONTRACT_LLM=1
TKNT_SEMANTIC_ADAPTIVE_LLM=0
TKNT_SEED_CONCEPT_GUIDED_LLM=0
TKNT_STYLE_POLICY_REQUIRE_LLM=0
TKNT_TIER_COUNT_USE_SIZE_RULES=1

# =========================
# Snapshot / image rendering
# =========================
TKNT_IMAGE_PROVIDER=openai
TKNT_SNAPSHOT_RENDER_REWRITE_MODEL=
TKNT_SNAPSHOT_RENDER_IMAGE_MODEL=
TKNT_SNAPSHOT_RENDER_IMAGE_SIZE=
TKNT_SNAPSHOT_RENDER_MAX_TOKENS=256
TKNT_OPENAI_IMAGE_MODEL=gpt-image-2
TKNT_OPENAI_IMAGE_SIZE=1536x1024
TKNT_OPENAI_IMAGE_QUALITY=medium
TKNT_OPENAI_IMAGE_STREAM_PARTIAL_IMAGES=2
TKNT_SNAPSHOT_RENDER_INCLUDE_ANNOTATED_REFERENCE=false
TKNT_SNAPSHOT_RENDER_INCLUDE_GEOMETRY_REFERENCES=false
TKNT_SNAPSHOT_RENDER_INCLUDE_LOCKED_GEOMETRY_REFERENCES=false
TKNT_SNAPSHOT_RENDER_INCLUDE_PRESET_REFERENCE_IMAGES=true
TKNT_SNAPSHOT_RENDER_SIMPLE_PROMPT=false

# =========================
# Visual relation planner
# =========================
TKNT_VISUAL_RELATION_PLANNER=
TKNT_VISUAL_RELATION_SOLVER=
TKNT_VISUAL_RELATION_MODEL=
VITE_TKNT_VISUAL_RELATION_PLANNER_MODE=

# =========================
# Search cache / crawl
# =========================
SEARCH_PROVIDER=google
SEARCH_FALLBACK=duckduckgo
SEARCH_CACHE_TTL_SEC=86400
SEARCH_CACHE_MAX=200
SEARCH_CACHE_PATH=logs/search_cache.json
SEARCH_CONTENT_CACHE_PATH=logs/search_content_cache.json
SEARCH_CONTENT_CACHE_MAX=400

# =========================
# Logging / diagnostics
# =========================
LOG_ALL_FILENAME=
FIX_HISTORY_MAX_ENTRIES=200
FIX_HISTORY_MAX_ISSUES=50
FIX_HISTORY_MAX_CHANGES=200
UI_SNAPSHOT_DIR=logs/ui_snapshots

# =========================
# Legacy compatibility flags
# =========================
TKNT_GEMINI_DISABLE_MODEL_FALLBACK=0
TKNT_GEMINI_BENCHMARK_TEXT_MODEL=
